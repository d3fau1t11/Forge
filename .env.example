# FORGE Environment Configuration Example

# LLM Providers API Keys
GEMINI_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AGENTROUTER_API_KEY=

# Optional Providers
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=

# Database Configuration
# Default sqlite for development, postgresql://user:pass@localhost:5432/forge for production
DATABASE_URL=sqlite:///./forge.db

# Budget Controls
PAID_MODEL_ALLOWED=false
DAILY_BUDGET_USD=5.00
SESSION_BUDGET_USD=2.00

# Security & Server Settings
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-in-production-forge-secret-key
ENVIRONMENT=development

# API auth gate. Leave EMPTY to disable auth (local dev mode); set a value before any
# deployment reachable outside localhost — every /api route then requires it in the
# X-Forge-Key header. Mirror the same value into frontend/.env as VITE_FORGE_API_KEY.
FORGE_API_KEY=

# Comma-separated CORS origin allowlist. Never use "*" here.
FORGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
